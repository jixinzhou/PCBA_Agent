    },
    {
      "rule_id": "SPI-VTE-HIGH-001",
      "expression": "spi_vte_prediction.data.vte_mean > 100.0",
      "applies_to": [
        "excessive_solder"
      ],
      "effect": "支持焊膏沉积过量候选路径，但不声明唯一根因。",
      "status": "approved_by_user_2026-08-30",
      "note": "VTE>100不能作为少锡的支持证据。"
    },
    {
      "rule_id": "REFLOW-PWI-HIGH-001",
      "expression": "reflow_profile_prediction.data.overall.max_pwi > 100.0",
      "applies_to": [
        "shifted_component.reflow_thermal_imbalance"
