# Qwen OpenAI-compatible API. Copy this file to agent/.env and keep real values local.
QWEN_API_KEY=
QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash-2026-07-15
QWEN_TIMEOUT_SECONDS=120
QWEN_MAX_RETRIES=2

# Restrict checkpoint deserialization to known-safe msgpack types.
LANGGRAPH_STRICT_MSGPACK=true
